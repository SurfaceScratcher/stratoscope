{
  "name": "stratoscope-ci",
  "version": "0.1.0",
  "description": "CI pipelines, workflows and steps from Woodpecker or Drone as a stratoscope topology, with their dependencies and state.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurfaceScratcher/stratoscope.git",
    "directory": "connectors/ci"
  },
  "homepage": "https://github.com/SurfaceScratcher/stratoscope/tree/main/connectors/ci#readme",
  "bugs": "https://github.com/SurfaceScratcher/stratoscope/issues",
  "type": "module",
  "keywords": [
    "stratoscope",
    "woodpecker",
    "drone",
    "ci",
    "pipelines",
    "topology"
  ],
  "bin": {
    "stratoscope-ci": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "stratoscope": "^0.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
