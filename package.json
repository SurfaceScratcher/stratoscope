{
  "name": "stratoscope-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "connectors/*"
  ],
  "scripts": {
    "build": "npm run build -w stratoscope && npm run build -w stratoscope-ci",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
